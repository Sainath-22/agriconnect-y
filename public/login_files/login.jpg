._lk21hp0 { background-color: var(--campaign-background); }

._lk21hp6 { max-width: 950px; }

._lk21hpf { color: var(--campaign-title); }

._lk21hpj { color: var(--campaign-text); }

._lk21hpk { background-color: var(--campaign-button); color: var(--campaign=
-button_text); }

._lk21hpk:hover { background-color: var(--campaign-button_hover); }

._lk21hpl { color: var(--campaign-countdown_text); background-color: var(--=
campaign-countdown); }

._lk21hpm { color: var(--campaign-text); }

._lk21hpo { color: var(--campaign-title); }

._lk21hpf b, ._lk21hpf strong { display: inline-block; color: var(--campaig=
n-title_strong); }

._lk21hpj b, ._lk21hpj strong { display: inline-block; color: var(--campaig=
n-text_strong); }

._lk21hpj .inline-block { display: inline-block; }

